{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "GDScript: Launch Project A",
			"type": "godot",
			"request": "launch",
			"project": "${workspaceFolder}",
			"debug_collisions": false,
			"debug_paths": false,
			"debug_navigation": false,
			"additional_options": "--simulate-player=PlayerA",
		},
		{
			"name": "GDScript: Launch Project B",
			"type": "godot",
			"request": "launch",
			"project": "${workspaceFolder}",
			"debug_collisions": false,
			"debug_paths": false,
			"debug_navigation": false,
			"additional_options": "--simulate-player=PlayerB"
		},
		{
			"name": "Start Training",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/godot-rl-agents/train.py",
			"cwd": "${workspaceFolder}/godot-rl-agents",
			"console": "integratedTerminal",
			"justMyCode": false,
		}
	]
}
